# Postgres from `docker compose up -d db`
DATABASE_URL=postgresql://app:app@localhost:5432/appointments
# Backend port; the Vite dev proxy forwards /v1 here too
PORT=3000
# Signs session cookies, at least 32 characters. Local only: deployed
# environments generate their own secret
SESSION_SECRET=local-dev-only-session-secret-change-me
# The address the browser uses: confirmation links and the Origin check.
# http://localhost:5173 with `npm run dev`; the backend's own address
# (http://localhost:3000) with `npm start`
PUBLIC_BASE_URL=http://localhost:5173
