{
  "name": "appointment-confirmation",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "dev": "concurrently --names backend,frontend --prefix-colors blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "db:migrate": "npm run db:migrate -w backend --",
    "db:seed": "npm run db:seed -w backend",
    "db:seed:if-empty": "npm run db:seed:if-empty -w backend",
    "test": "npm test --workspaces",
    "lint": "eslint . && npm run lint:openapi",
    "lint:openapi": "redocly lint openapi.yaml",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.77.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2"
  }
}
